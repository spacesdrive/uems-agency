# Dependencies and build output
node_modules
dist
dist-ssr
coverage
*.tsbuildinfo

# Environment and local overrides (never commit real values; .env.example is the template)
.env
.env.*
!.env.example
*.local

# Credentials and keys
.cloudflare-keys
.cloudflare*
*.pem
*.key
*.p12
*.pfx
*.crt
.dev.vars
.dev.vars.*
secrets.*
credentials*.json

# Cloudflare / Wrangler local state
.wrangler

# Logs and editor/OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea

# Generated by `wrangler types` (npm run types:worker)
worker/worker-configuration.d.ts

# Raw photos never ship from public/images (it holds optimised WebP files only).
# Keep originals, metadata stripped, in assets/originals/.
public/images/*.[jJ][pP][gG]
public/images/*.[jJ][pP][eE][gG]
public/images/*.[pP][nN][gG]
public/images/*.[hH][eE][iI][cC]

# Untouched camera originals stay local (they can contain GPS data).
assets/originals/raw/
