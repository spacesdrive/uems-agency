// Cloudflare Workers deployment. Every page is a pre-rendered HTML file in dist/, served
// straight from Cloudflare's edge. The small Worker in worker/ only handles /api/enquiry,
// which emails form submissions to UEMS.
// Credentials are never stored here. Wrangler reads CLOUDFLARE_API_TOKEN and
// CLOUDFLARE_ACCOUNT_ID from the environment (GitHub Actions secrets in CI).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uems-agency",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the form endpoint runs the Worker first; pages and files are served directly.
    "run_worker_first": ["/api/*"],
    // /about-us redirects to /about-us/ (the canonical form used by every page).
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get the pre-rendered 404.html with a real 404 status.
    "not_found_handling": "404-page"
  },
  // At most 5 form submissions per minute from one visitor (per Cloudflare location).
  "ratelimits": [{ "name": "ENQUIRY_LIMITER", "namespace_id": "41201", "simple": { "limit": 5, "period": 60 } }],
  // Form emails are sent via Resend (from info@uemsventures.com to info@uemsventures.com, with the
  // visitor as reply-to) using the RESEND_API_KEY secret (wrangler secret put RESEND_API_KEY).
  // If the key is missing or the API fails, the site falls back to the visitor's mail app.
  // Zone routes: the Worker intercepts all traffic on the zone and serves the new site,
  // bypassing the old origin. DNS records (incl. MX for email) are left untouched, so
  // removing these routes instantly reverts to the previous origin.
  "routes": [
    { "pattern": "uemsventures.com/*", "zone_name": "uemsventures.com" },
    { "pattern": "www.uemsventures.com/*", "zone_name": "uemsventures.com" }
  ],
  // Serve only on the custom domain; no public *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
