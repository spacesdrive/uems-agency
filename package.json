{
  "name": "uems-ventures",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run types:worker --silent && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "npm run types:worker --silent && tsc -b",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:dist": "node scripts/verify-dist.mjs",
    "deploy": "wrangler deploy",
    "preview:cf": "wrangler dev --port 4393",
    "types:worker": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "jsdom": "30.1.2",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
